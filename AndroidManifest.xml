<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.mehdi.barcahome" android:versionCode="1" android:versionName="1.4">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
 <uses-feature android:name="android.software.leanback" android:required="true" />
 <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
 <queries>
  <package android:name="com.google.android.youtube.tv" />
  <package android:name="com.mitv.livetv" />
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent>
 </queries>
 <application android:label="Barça Home" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false" android:supportsRtl="true">
  <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape">
   <intent-filter>
    <action android:name="android.intent.action.MAIN" />
    <category android:name="android.intent.category.HOME" />
    <category android:name="android.intent.category.DEFAULT" />
   </intent-filter>
   <intent-filter>
    <action android:name="android.intent.action.MAIN" />
    <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
   </intent-filter>
  </activity>
 </application>
</manifest>
